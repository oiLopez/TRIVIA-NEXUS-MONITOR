# ============================================================
# NEXUS MONITOR - Git Ignore
# ============================================================

# NEXUS MONITOR - cópias locais com dados reais
backend/config/*.local.config
backend/collectors/*.local.sh
docs/*.local.md

# NEXUS MONITOR - dados gerados localmente
backend/data/**/*.csv
backend/logs/**/*.log
backend/logs/*.log

# Arquivos temporários
*.tmp
*.bak
*.swp
*~

# Dados operacionais atuais gerados por coletores
backend/data/current/alertas_ativos.csv
backend/data/current/operacao_servidores.csv
backend/data/current/painel_sinotico.csv

# Histórico operacional gerado por coletores
backend/data/history/alertas_historico.csv
backend/data/history/historico_migracoes.csv


# Logs
*.log
logs/
backend/logs/*
!backend/logs/.gitkeep

# Arquivos temporários
*.tmp
*.temp
*.swp
*.swo
*~

# Backups de editores
*.bak
*.old
*.orig

# Sistema operacional
.DS_Store
Thumbs.db

# Cache
.cache/
__pycache__/

# Dados gerados automaticamente
backend/data/history/*
backend/data/samples/generated/*
!backend/data/history/.gitkeep
!backend/data/samples/.gitkeep

# Arquivos sensíveis locais
*.env
.env
.env.local

# Configurações locais não versionadas
local.config
*.local

# NEXUS MONITOR - dados gerados localmente / runtime
backend/data/current/*.csv
backend/data/events/*.csv
backend/data/runtime/*.csv

# Manter arquivos de exemplo versionados
!backend/data/samples/*.csv

# Manter diretórios versionados
!backend/data/current/.gitkeep
!backend/data/events/.gitkeep
!backend/data/runtime/.gitkeep

# NEXUS MONITOR - arquivos locais com dados reais
frontend/index.local.html
frontend/assets/data/local/

# Configurações locais/sensíveis
backend/config/*.local.csv
backend/config/*.local

# Runtime local gerado automaticamente
backend/data/runtime/**
!backend/data/runtime/
!backend/data/runtime/.gitkeep
